    {
      "parameters": {
        "jsCode": "let contacts = $input.all();\nlet output = [];\n\n// 🔹 Lista MAESTRA de custom fields\nconst allCustomFields = [\n  \"País Nacionalidad\",\n  \"Destino de Interes\",\n  \"Vencimiento visa actual\",\n  \"Actual - Tipo de visa vigente\",\n  \"Datos de emergencia Numero telefonico\",\n  \"Datos de emergencia Email\",\n  \"Datos de Emergencia Nombres y Apellidos - Parentesco\",\n  \"Localización del estudiante\",\n  \"Genero\",\n  \"Oficina Blue Studies\",\n  \"Estado Civil\",\n  \"Nombre Subagencia\",\n  \"Sector Laboral o de Interes\",\n  \"Referido de otro estudiante? (nombre completo)\",\n  \"Programa de interés\",\n  \"Primer Idioma\",\n  \"Otra ciudadania:\",\n  \"Nivel Educativo Mas alto:\",\n  \"Nivel de ingles\",\n  \"Admin Angel (solo admin asigna)\",\n  \"EB3 - Fondos\",\n  \"Nivel de Inglés Actual\",\n  \"Nucleo Familiar ( Pareja e Hijos)\",\n  \"Proyección de fecha\",\n  \"Ocupación\",\n  \"Objetivo\",\n  \"Examen de idiomas, Puntaje ,y fecha de presentación\",\n  \"Pais\",\n  \"Convenio\",\n  \"Cómo costeará el programa\",\n  \"Expo Exterior\",\n  \"Link lineup\"\n];\n\nfor (const item of contacts) {\n  let contact = item.json;\n\n  /* ===============================\n   * CASTEAR CUSTOM FIELDS\n   * =============================== */\n  let parsedCustomFields = [];\n\n  if (typeof contact.custom_fields === 'string') {\n    try {\n      parsedCustomFields = JSON.parse(contact.custom_fields);\n    } catch {\n      parsedCustomFields = [];\n    }\n  } else if (Array.isArray(contact.custom_fields)) {\n    parsedCustomFields = contact.custom_fields;\n  }\n\n  /* ===============================\n   * INICIALIZAR TODOS EN VACÍO\n   * =============================== */\n  let customFieldsResult = {};\n  allCustomFields.forEach(field => {\n    customFieldsResult[field] = \"\";\n  });\n\n  /* ===============================\n   * MATCHEAR LOS EXISTENTES\n   * =============================== */\n  parsedCustomFields.forEach(cf => {\n    if (cf?.field && customFieldsResult.hasOwnProperty(cf.field)) {\n      customFieldsResult[cf.field] = cf.value ?? \"\";\n    }\n  });\n\n  /* ===============================\n   * CASTEAR TAGS + AGREGAR TAG\n   * =============================== */\n  let tags = [];\n\n  if (typeof contact.tags === 'string') {\n    try {\n      tags = JSON.parse(contact.tags);\n    } catch {\n      tags = [];\n    }\n  } else if (Array.isArray(contact.tags)) {\n    tags = contact.tags;\n  }\n\n  if (!tags.includes('migration_clientify')) {\n    tags.push('migration_clientify');\n  }\n\n  /* ===============================\n   * REEMPLAZAR EN CONTACTO\n   * =============================== */\n  contact.custom_fields = customFieldsResult;\n  contact.tags = tags;\n\n  output.push({ json: contact });\n}\n\nreturn output;\n"
      },
