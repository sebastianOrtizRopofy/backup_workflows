      "parameters": {
        "jsCode": "const items = $input.all();\nconst allFields = new Set();\n\nitems.forEach(item => {\n  let customFields = item.json.custom_fields;\n\n  // 🔹 Castear si viene como string\n  if (typeof customFields === 'string') {\n    try {\n      customFields = JSON.parse(customFields);\n    } catch (e) {\n      customFields = [];\n    }\n  }\n\n  // 🔹 Validar que sea array\n  if (Array.isArray(customFields)) {\n    customFields.forEach(cf => {\n      if (cf?.field) {\n        allFields.add(cf.field);\n      }\n    });\n  }\n});\n\n// 🔹 Resultado final\nreturn [\n  {\n    json: {\n      total_custom_fields: allFields.size,\n      custom_fields: Array.from(allFields)\n    }\n  }\n];\n"
      },
