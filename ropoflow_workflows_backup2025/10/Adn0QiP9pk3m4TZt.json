    {
      "parameters": {
        "jsCode": "// Tomar el id que viene del nodo \"Code\"\nconst codeItem = $('Loop Over Components').first();\nconst mainId = String(codeItem?.json?.id ?? '');\nconst mainName = String(codeItem?.json?.name ?? '');\n\n// Tomar el array de componentes que viene del nodo \"Array Components\"\nconst compItem = $items('Array Components', 0, 0)?.[0];\nconst components = compItem?.json?.components ?? [];  // <- debería ser un array\n\n// ¿Algún componente tiene description == id?\nconst exists = components.some(c => String(c?.description ?? '') === mainId);\n\n// Output: un solo item con el resultado\nreturn [\n  {\n    json: {\n      id: mainId,\n      name: mainName,\n      exists\n    }\n  }\n];\n"
      },
