        "jsCode": "// Tomar el id que viene del nodo \"Code\"\nconst codeItem = $('Loop Over Items2').first();\nconst mainId = String(codeItem?.json?.id ?? '');\nconst mainName = String(codeItem?.json?.title ?? '');\nconst mainStatus = String(codeItem?.json?.status ?? '');\n\n// Tomar el array de componentes que viene del nodo \"Array Components\"\nconst compItem = $items('Array Incidents', 0, 0)?.[0];\nconst components = compItem?.json?.incidents ?? [];  // <- debería ser un array\n\n// ¿Algún componente tiene name que incluya el id?\nconst exists = components.some(c => String(c?.name ?? '').includes(mainId));\n\n// Output: un solo item con el resultado\nreturn [\n  {\n    json: {\n      id: mainId,\n      name: mainName,\n      status: mainStatus,\n      exists\n    }\n  }\n];\n"
