    {
      "parameters": {
        "jsCode": "// Asegúrate de que los datos de entrada se reciban correctamente\nconst data = $input.all()[0].json; // Si tienes múltiples entradas, toma el primero\n\n// Resultado final\nconst result = [];\n\n// Verifica si data tiene la propiedad pipelines\nif (data.pipelines && Array.isArray(data.pipelines)) {\n  // Iterar sobre cada pipeline\n  data.pipelines.forEach(pipeline => {\n    // Verifica si el pipeline tiene la propiedad stages\n    if (pipeline.stages && Array.isArray(pipeline.stages)) {\n      // Iterar sobre cada stage dentro de cada pipeline\n      pipeline.stages.forEach(stage => {\n        // Formatear y agregar el objeto al resultado\n        result.push({\n          id_pipeline: pipeline.id,\n          id_stage: stage.id,\n          name_stage: stage.name,\n        });\n      });\n    }\n  });\n}\n\n// Retornar el resultado\nreturn result;\n"
      },
