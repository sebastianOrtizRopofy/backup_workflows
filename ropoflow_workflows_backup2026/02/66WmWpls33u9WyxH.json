    {
      "parameters": {
        "jsCode": "let pipelines_stages_permitidos = [\n  {\n    \"pipeline_permitido\": \"2E5GUmKgx040LTxoPPh9\", // Atención comercial\n    \"stages_permitidos\": [\n      \"c6747108-2650-4c4c-92f9-3901bc231c75\" // apartado solicitado\n    ]\n  }\n];\n\n// Accedemos a las oportunidades del input\nconst oportunidades = $input.first().json.opportunities || [];\n\n// Usamos .some() para devolver true si al menos una cumple la condición\nlet esValido = oportunidades.some(oportunidad => {\n  // Buscamos si el pipeline de la oportunidad está en nuestra lista de permitidos\n  const configuracionPipeline = pipelines_stages_permitidos.find(\n    p => p.pipeline_permitido === oportunidad.pipelineId\n  );\n\n  // Si el pipeline coincide, revisamos si el stage también está permitido\n  if (configuracionPipeline) {\n    return configuracionPipeline.stages_permitidos.includes(oportunidad.pipelineStageId);\n  }\n\n  return false;\n});\n\n// Retornamos el resultado en el formato de n8n\nreturn {\n  permitido: esValido\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
