    },
    {
      "parameters": {
        "jsCode": "let conversaciones = $input.first().json.conversations;\n\n// Si no hay conversaciones, devolver vacío\nif (!conversaciones || conversaciones.length === 0) {\n  return [];\n}\n\n// Buscar la conversación más reciente (por fecha)\nlet masReciente = conversaciones.reduce((a, b) => {\n  return a.lastMessageDate > b.lastMessageDate ? a : b;\n});\n\n// Devolver solo 1 ítem (el más reciente)\nreturn [{ json: masReciente }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
