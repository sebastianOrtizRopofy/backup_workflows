      "name": "obtener mensajes"
    },
    {
      "parameters": {
        "jsCode": "// 🧩 Atributos que quieres conservar\nconst atributos = [\n  \"body\",\n  \"direction\",\n  \"dateAdded\",\n  \"attachments\"\n];\n\n// Obtener todos los items de entrada\nconst items = $input.all();\n\n// Acumulador de todos los mensajes\nlet todosLosMensajes = [];\n\n// Recorrer cada item y extraer los mensajes\nfor (const item of items) {\n  const mensajes = item.json.messages?.messages || [];\n  \n  // Filtrar solo los atributos que te interesan\n  const filtrados = mensajes.map(msg => {\n    let nuevo = {};\n    for (const key of atributos) {\n      if (msg.hasOwnProperty(key)) {\n        nuevo[key] = msg[key];\n      }\n    }\n    return nuevo;\n  });\n\n  todosLosMensajes.push(...filtrados);\n}\n\n// Ordenar por fecha (opcional)\ntodosLosMensajes.sort((a, b) => new Date(b.dateAdded) - new Date(a.dateAdded));\n\n// Devolver todos los mensajes filtrados\nreturn [{ json: { mensajes: todosLosMensajes } }];\n"
      },
