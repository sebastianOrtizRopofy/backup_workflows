    {
      "parameters": {
        "jsCode": "// Obtener los datos de los inputs\nlet inputs = $input.all();\n\n// Array para almacenar los resultados (cada customField será un item)\nlet resultados = [];\n\n// Recorrer cada objeto de input\ninputs.forEach(input => {\n    let customFields = input.json.customFields;\n\n    // Verificar que customFields existe y es un objeto\n    if (customFields) {\n        // Agregar customFields al array de resultados, incluyendo el ID de la oportunidad/contacto\n        for (let key in customFields) {\n            if (customFields.hasOwnProperty(key)) {\n                let customField = customFields[key];\n\n                // Agregar el ID de la oportunidad/contacto a cada campo personalizado\n                customField.opportunityId = input.json.opportunityId;\n                customField.timestamp = input.json.updatedAt;\n\n                // Crear un nuevo item para cada customField\n                resultados.push({\n                    json: customField // Cada customField es un item con la estructura { json: customField }\n                });\n            }\n        }\n    }\n});\n\n// Retornar el array de resultados como 'items' para n8n\nreturn resultados;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2620,
        -20
      ],
      "id": "58ab847c-254e-4b90-9390-84cfabbc880d",
      "name": "Lógica CF Oportunidades"
    },
    {
      "parameters": {
        "jsCode": "let paginas = $input.all();\nlet oportunidades = [];\npaginas.forEach((pagina)=>{\n  pagina.json.opportunities.forEach((oportunidad)=>{\n    oportunidades.push({\n      json: oportunidad\n    })\n  })\n})\n\nreturn oportunidades;"
      },
