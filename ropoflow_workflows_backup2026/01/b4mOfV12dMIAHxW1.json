    {
      "parameters": {
        "jsCode": "// Entrada: array de objetos\nconst input = $input.all();\n\n// Límite de tamaño por lote\nconst batchSize = 500;\nlet batches = [];\n\n// Función para dividir el array en lotes de 500\nfor (let i = 0; i < input.length; i += batchSize) {\n    const batch = input.slice(i, i + batchSize);\n    // Cada lote es un ítem, devolvemos solo el array bajo 'json'\n    batches.push({ json: {customFields: batch} });\n}\n\n// Salida: devolvemos los lotes como ítems\nreturn batches;\n"
      },
